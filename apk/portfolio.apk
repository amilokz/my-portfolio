// Add to App.jsx or create DownloadApp.jsx
import { Smartphone, Download } from 'lucide-react';

export default function DownloadApp() {
  const downloadAPK = () => {
    // Create a dummy APK or link to your actual APK
    const link = document.createElement('a');
    link.href = '/apk/portfolio.apk';
    link.download = 'KomilPortfolio.apk';
    link.click();
  };

  return (
    <div style={{
      position: 'fixed',
      bottom: '20px',
      right: '20px',
      zIndex: 1000,
    }}>
      <button
        onClick={downloadAPK}
        style={{
          background: 'linear-gradient(135deg, #00cfff, #8b5cf6)',
          border: 'none',
          borderRadius: '50px',
          padding: '10px 20px',
          color: 'white',
          cursor: 'pointer',
          display: 'flex',
          alignItems: 'center',
          gap: '8px',
          fontSize: '0.8rem',
          boxShadow: '0 0 15px rgba(0,204,255,0.5)',
        }}
      >
        <Smartphone size={16} />
        <Download size={14} />
        Download App (APK)
      </button>
    </div>
  );
}